---
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{{ locale.permalink }}"
---
<!doctype html>
<html lang="{{ locale.lang }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ locale.metaDescription }}">
    <meta name="theme-color" content="#f5f6ee">
    <meta property="og:title" content="{{ locale.metaTitle }}">
    <meta property="og:description" content="{{ locale.metaDescription }}">
    <meta property="og:type" content="website">
    <title>{{ locale.metaTitle }}</title>
    <link rel="icon" href="{{ '/assets/favicon.svg' | url }}" type="image/svg+xml">
    <link rel="stylesheet" href="{{ '/assets/site.css' | url }}">
    <script src="{{ '/assets/site.js' | url }}" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="{{ '/' | url }}" aria-label="Codomain home">
        <span class="brand-mark" aria-hidden="true"><span></span><span></span></span>
        <span>codomain</span>
      </a>
      <nav class="site-nav" aria-label="Primary navigation">
        <a href="#workflow">{{ locale.navHow }}</a>
        <a href="#principles">{{ locale.navPrinciples }}</a>
        <a href="#scope">{{ locale.navScope }}</a>
      </nav>
      <div class="header-actions">
        <a class="language" href="{{ locale.alternateUrl }}" lang="{% if locale.lang == 'en' %}tr{% else %}en{% endif %}">{{ locale.alternateLabel }}</a>
        <a class="button button-small button-dark" href="{{ locale.repositoryUrl }}" target="_blank" rel="noreferrer">{{ locale.githubLabel }}</a>
      </div>
    </header>

    <main id="main">
      <section class="hero section-shell">
        <div class="hero-copy reveal">
          <p class="eyebrow"><span></span>{{ locale.eyebrow }}</p>
          <h1>{{ locale.heroTitle }}</h1>
          <p class="hero-body">{{ locale.heroBody }}</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#workflow">{{ locale.heroPrimary }}</a>
            <a class="text-link" href="{{ locale.repositoryUrl }}" target="_blank" rel="noreferrer">{{ locale.heroSecondary }}</a>
          </div>
        </div>

        <div class="product-visual reveal" aria-label="{{ locale.demoLabel }}">
          <div class="window-bar"><i></i><i></i><i></i><span>codomain / publish</span></div>
          <div class="prompt-row">
            <span class="prompt-avatar">AI</span>
            <p>{{ locale.demoPrompt }}</p>
            <span class="send-arrow">&lt;/&gt;</span>
          </div>
          <div class="flow-card">
            <div class="status-line"><span class="status-dot"></span><strong>{{ locale.demoReady }}</strong><span class="status-time">00:12</span></div>
            <div class="mini-site" aria-hidden="true">
              <div class="mini-nav"></div><div class="mini-title"></div><div class="mini-copy"></div><div class="mini-button"></div>
            </div>
            <div class="review-row"><span>◉</span><span>{{ locale.demoReview }}</span><strong>✓</strong></div>
          </div>
          <div class="publish-row">
            <span class="approval">✓ {{ locale.demoApproved }}</span>
            <span class="connector"></span>
            <span class="live"><i></i>{{ locale.demoLive }}</span>
          </div>
        </div>
      </section>

      <div class="proof-strip" aria-label="Product highlights">
        <span>{{ locale.proofOne }}</span><i></i><span>{{ locale.proofTwo }}</span><i></i><span>{{ locale.proofThree }}</span>
      </div>

      <section class="workflow section-shell" id="workflow">
        <div class="section-intro reveal">
          <p class="eyebrow"><span></span>{{ locale.workflowEyebrow }}</p>
          <h2>{{ locale.workflowTitle }}</h2>
          <p>{{ locale.workflowBody }}</p>
        </div>
        <div class="steps">
          {% for step in locale.steps %}
            <article class="step reveal">
              <div class="step-icon" aria-hidden="true">{% if loop.index == 1 %}✦{% elif loop.index == 2 %}◫{% elif loop.index == 3 %}✓{% else %}↗{% endif %}</div>
              <h3>{{ step.title }}</h3>
              <p>{{ step.body }}</p>
            </article>
          {% endfor %}
        </div>
      </section>

      <section class="principles" id="principles">
        <div class="section-shell">
          <div class="section-intro reveal">
            <p class="eyebrow eyebrow-light"><span></span>{{ locale.principlesEyebrow }}</p>
            <h2>{{ locale.principlesTitle }}</h2>
          </div>
          <div class="principle-grid">
            {% for principle in locale.principles %}
              <article class="principle reveal">
                <h3>{{ principle.title }}</h3>
                <p>{{ principle.body }}</p>
              </article>
            {% endfor %}
          </div>
        </div>
      </section>

      <section class="scope section-shell" id="scope">
        <div class="section-intro reveal">
          <p class="eyebrow"><span></span>{{ locale.scopeEyebrow }}</p>
          <h2>{{ locale.scopeTitle }}</h2>
        </div>
        <div class="scope-grid">
          <article class="scope-card included reveal">
            <p class="scope-label"><span>✓</span>{{ locale.includedTitle }}</p>
            <ul>{% for item in locale.included %}<li>{{ item }}</li>{% endfor %}</ul>
          </article>
          <article class="scope-card excluded reveal">
            <p class="scope-label"><span>–</span>{{ locale.excludedTitle }}</p>
            <ul>{% for item in locale.excluded %}<li>{{ item }}</li>{% endfor %}</ul>
          </article>
        </div>
      </section>

      <section class="open-source section-shell reveal">
        <div>
          <p class="eyebrow"><span></span>{{ locale.ctaEyebrow }}</p>
          <h2>{{ locale.ctaTitle }}</h2>
          <p>{{ locale.ctaBody }}</p>
        </div>
        <a class="button button-dark" href="{{ locale.repositoryUrl }}" target="_blank" rel="noreferrer">{{ locale.ctaButton }}</a>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-main">
        <a class="brand brand-footer" href="{{ '/' | url }}"><span class="brand-mark" aria-hidden="true"><span></span><span></span></span><span>codomain</span></a>
        <p>{{ locale.footerTagline }}</p>
      </div>
      <div class="footer-meta">
        <span>© 2026 Codomain</span>
        <a href="{{ locale.sponsorUrl }}" target="_blank" rel="sponsored noreferrer">{{ locale.sponsorPrefix }} <strong>ehost.com.tr</strong></a>
      </div>
    </footer>
  </body>
</html>
